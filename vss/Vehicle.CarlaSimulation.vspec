# SPDX-License-Identifier: MIT
# Project-owned extension for COVESA VSS 6.0. It is not part of standard VSS.

Vehicle.CarlaSimulation:
  type: branch
  description: CARLA simulation synchronization metadata.

Vehicle.CarlaSimulation.ProfileVersion:
  datatype: string
  type: attribute
  default: "0.2"
  description: Version of the CARLA VISS compatibility profile.

Vehicle.CarlaSimulation.RunId:
  datatype: string
  type: sensor
  description: Unique identifier of one simulator run.

Vehicle.CarlaSimulation.EgoVehicleId:
  datatype: string
  type: sensor
  description: Stable ego vehicle actor identifier within the run.

Vehicle.CarlaSimulation.FrameId:
  datatype: uint64
  type: sensor
  min: 0
  description: CARLA simulation frame represented by this state update.

Vehicle.CarlaSimulation.SimulationTime:
  datatype: double
  type: sensor
  unit: s
  min: 0
  description: Elapsed CARLA simulation time.

Vehicle.CarlaSimulation.GnssFrameId:
  datatype: uint64
  type: sensor
  min: 0
  description: CARLA source frame of the retained GNSS fix.

Vehicle.CarlaSimulation.GnssSimulationTime:
  datatype: double
  type: sensor
  unit: s
  min: 0
  description: CARLA source simulation time of the retained GNSS fix.

Vehicle.CarlaSimulation.Control:
  type: branch
  description: Applied simulator control facts attributable to the current CARLA frame.

Vehicle.CarlaSimulation.Control.ActiveMode:
  datatype: string
  type: sensor
  allowed: ["SAFE_STOP", "SCENARIO", "MANUAL", "AUTOPILOT"]
  description: Control mode actually applied for the current CARLA frame.

Vehicle.CarlaSimulation.Control.TransitionState:
  datatype: string
  type: sensor
  allowed: ["STABLE", "PREPARING", "FAILED"]
  description: Applied control transition state for the current CARLA frame.

Vehicle.CarlaSimulation.Control.Generation:
  datatype: uint64
  type: sensor
  min: 0
  description: Monotonic accepted control transaction generation.

Vehicle.CarlaSimulation.Reset:
  type: branch
  description: Simulator reset facts attributable to the current CARLA frame.

Vehicle.CarlaSimulation.Reset.Generation:
  datatype: uint64
  type: sensor
  min: 0
  description: Monotonic generation of the latest successful canonical reset.

Vehicle.CarlaSimulation.Reset.InProgress:
  datatype: boolean
  type: sensor
  description: True while a canonical physical reset is being completed or failed.

Vehicle.CarlaSimulation.Reset.Discontinuity:
  datatype: boolean
  type: sensor
  description: True only for the first complete state snapshot after a successful reset.

Vehicle.CarlaSimulation.ChaosWheel:
  type: branch
  description: Simulator-specific live wheel dynamics from the Unreal Chaos solver.

Vehicle.CarlaSimulation.ChaosWheel.Row1:
  type: branch
  description: Simulator-specific front axle wheel dynamics.

Vehicle.CarlaSimulation.ChaosWheel.Row1.Left:
  type: branch
  description: Simulator-specific front-left wheel dynamics.

Vehicle.CarlaSimulation.ChaosWheel.Row1.Left.LateralSlipAngle:
  datatype: double
  type: sensor
  unit: degrees
  description: Live Chaos lateral slip angle for the front-left wheel.

Vehicle.CarlaSimulation.ChaosWheel.Row1.Left.LongitudinalSlip:
  datatype: double
  type: sensor
  description: Live Chaos longitudinal slip magnitude for the front-left wheel.

Vehicle.CarlaSimulation.ChaosWheel.Row1.Right:
  type: branch
  description: Simulator-specific front-right wheel dynamics.

Vehicle.CarlaSimulation.ChaosWheel.Row1.Right.LateralSlipAngle:
  datatype: double
  type: sensor
  unit: degrees
  description: Live Chaos lateral slip angle for the front-right wheel.

Vehicle.CarlaSimulation.ChaosWheel.Row1.Right.LongitudinalSlip:
  datatype: double
  type: sensor
  description: Live Chaos longitudinal slip magnitude for the front-right wheel.

Vehicle.CarlaSimulation.ChaosWheel.Row2:
  type: branch
  description: Simulator-specific rear axle wheel dynamics.

Vehicle.CarlaSimulation.ChaosWheel.Row2.Left:
  type: branch
  description: Simulator-specific rear-left wheel dynamics.

Vehicle.CarlaSimulation.ChaosWheel.Row2.Left.LateralSlipAngle:
  datatype: double
  type: sensor
  unit: degrees
  description: Live Chaos lateral slip angle for the rear-left wheel.

Vehicle.CarlaSimulation.ChaosWheel.Row2.Left.LongitudinalSlip:
  datatype: double
  type: sensor
  description: Live Chaos longitudinal slip magnitude for the rear-left wheel.

Vehicle.CarlaSimulation.ChaosWheel.Row2.Right:
  type: branch
  description: Simulator-specific rear-right wheel dynamics.

Vehicle.CarlaSimulation.ChaosWheel.Row2.Right.LateralSlipAngle:
  datatype: double
  type: sensor
  unit: degrees
  description: Live Chaos lateral slip angle for the rear-right wheel.

Vehicle.CarlaSimulation.ChaosWheel.Row2.Right.LongitudinalSlip:
  datatype: double
  type: sensor
  description: Live Chaos longitudinal slip magnitude for the rear-right wheel.
